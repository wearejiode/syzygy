{
  "name": "@jiode/docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "docs/src",
  "projectType": "application",
  "private": true,
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astro dev",
        "cwd": "docs/"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astro build",
        "cwd": "docs/",
        "outputs": ["{workspaceRoot}/dist/apps/docs/spark-docs"]
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astro preview",
        "cwd": "docs/"
      }
    }
  },
  "tags": []
}
